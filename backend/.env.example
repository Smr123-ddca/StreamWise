# StreamWise Application Configuration
APP_NAME=StreamWise
APP_VERSION=0.1.0
DEBUG=True

# Storage Configuration (relative to backend or absolute path)
STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=500

# CORS / Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Optional: Path to ffprobe executable if not discoverable via system PATH
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Optional: Path to ffmpeg executable if not discoverable via system PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: Transcoding execution timeout in seconds
# TRANSCODING_TIMEOUT_SECONDS=120

# Optional: HLS packaging settings
# HLS_SEGMENT_DURATION_SECONDS=4
# HLS_TIMEOUT_SECONDS=180
